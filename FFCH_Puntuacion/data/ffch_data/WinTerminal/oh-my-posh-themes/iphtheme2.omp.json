{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 4,
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "type": "path",
                    "style": "plain",
                    "foreground": "p:path-bg",
                    "template": "\uf07c {{ .Path }} ",
                    "options": {
                        "style": "full",
                        "home_icon": "~",
						"display_cygpath": true
                    },
					"overrides": [
						{
						"if": "eq .Shell \"bash\"",
						"properties": {
							"folder_separator_icon": "/",
							"mapped_locations": {
								"C:": "/c"
							}
						}
						}
					]
                },
                {
                    "type": "git",
                    "style": "plain",
                    "foreground": "p:git-bg",
                    "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "node",
                    "style": "plain",
                    "foreground": "#98C379",
                    "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
                },
                {
                    "type": "go",
                    "style": "plain",
                    "template": "\ue724 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
                    "cache": {
                        "duration": "168h",
                        "strategy": "folder"
                    },
                    "foreground": "#63F08C"
                },
                {
                    "type": "angular",
                    "style": "plain",
                    "template": " \ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
                    "cache": {
                        "duration": "168h",
                        "strategy": "folder"
                    },
                    "foreground": "#F637E3"
                },
                {
					"type": "react",
					"style": "plain",
					"template": " \ue7ba {{ .Full }} ",
					"cache": {
						"duration": "168h",
						"strategy": "folder"
					},
					"foreground": "#58C4DC"
				},
				{
					"type": "shell",
					"style": "plain",
					"template": " \ue795 {{ .Name }} ",
					"cache": {
						"duration": "24h",
						"strategy": "session"
					},
					"foreground": "#0077c2"
				},
				{
					"type": "status",
					"style": "plain",
					"template": " {{ if eq .Code 0 }}\uf00c{{ else }}\uf071 {{ .Code }}{{ end }} ",
					"foreground": "#C94A16"
				},
				{
					"type": "time",
					"style": "plain",
					"template": " \uf017 {{ .CurrentDate | date .Format }} ",
					"foreground": "#00bfa5"
				}
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
					"type": "text",
					"style": "plain",
					"template": "{{ if eq .Shell \"pwsh\" }}PS > {{ else if eq .Shell \"powershell\" }}PS > {{ else }}$ {{ end }}",
					"foreground": "#0077c2"
				}
            ],
            "newline": true
        }
    ],
    "palette": {
        "text-light": "#ffffff",
        "path-bg": "#61AFEF",
        "git-bg": "#98C379"
    }
}